# Environment Variables
# Copy this to .env and fill in your values

# =============================================================================
# REQUIRED - JWT signing key. The server refuses to start without a strong one.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
# At least 32 characters. The placeholder text below is rejected on purpose.
# =============================================================================
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Database
# =============================================================================
# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finance_engine
# For development (SQLite, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./finance_engine.db

# =============================================================================
# Admin password, used once to create the "admin" account on a fresh database.
# At least 12 characters. Passwords once published in this repository are rejected.
# No other accounts are created automatically; add them with:
#   python create_admin.py --username NAME --name "Full Name" --role trader
# =============================================================================
DEFAULT_ADMIN_PASSWORD=

# =============================================================================
# MT5 Settings (optional - for live trading)
# =============================================================================
# Must match MT5_API_TOKEN on the connector. The connector refuses requests without one.
MT5_API_TOKEN=
MT5_CONNECTOR_URL=http://localhost:5001
MT5_BROKER_UTC_OFFSET=0

# =============================================================================
# HuggingFace Settings (optional - for data archiving)
# =============================================================================
HUGGINGFACE_API_KEY=
HF_REPO_ID=TheFinanceEngineer/impulse-market-data

# =============================================================================
# AI Providers (optional - can be configured in app settings)
NVIDIA_API_KEY=
GROQ_API_KEY=
OPEN_ROUTER_API_KEY=
GEMINI_API_KEY=
GITHUB_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
TOKENLB_API_KEY=
ZENMUX_API_KEY=

# =============================================================================
# SMTP / Daily Report Email (optional - for daily report delivery)
# =============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
REPORT_EMAIL=pradhantech813@gmail.com
# REPORT_EMAIL_PASSWORD=your-app-password-here
# REPORT_RECIPIENT_EMAIL=where-to-send-it@example.com
# SENDGRID_API_KEY= (preferred - uses HTTPS port 443, works on all servers)

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Heartbeat alerts over Telegram (optional). Create a bot with @BotFather, send it
# a message, then read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates.
# Without these, alerts are logged and listed on the Risk Limits card only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
