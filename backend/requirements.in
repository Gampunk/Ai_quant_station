# The packages the backend needs, edited by hand. Ranges are fine here.
#
# requirements.txt is generated from this file with every version exact. After
# editing this file, regenerate it (uv picks the newest allowed versions):
#
#   uv pip compile requirements.in -o requirements.txt --python-version 3.11 \
#     --extra-index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-best-match \
#     --emit-index-url
#
# The PyTorch index gives the CPU build of torch (needed by sentence-transformers),
# about 200 MB instead of several GB of GPU libraries.

