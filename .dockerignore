# Patterns here match from the repository root only, so "**/" is needed to
# reach backend/ and frontend/. Without it backend/.env (the signing key and
# admin password) and the local database were copied into the image.

# Secrets and local state
**/.env
**/.env.*
!**/.env.example
**/*.db
**/*.sqlite
**/*.db.*
**/*.bak

# Environments and caches
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/node_modules/
**/dist/
**/build/
*.egg-info/

# Not part of the server
.git
.gitignore
.idea/
.vscode/
*.swp
*.swo
mt5_connector/
data_archive/
backtest-expert/
scripts/
docs/
README.md
**/tests/
